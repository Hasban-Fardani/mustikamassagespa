---
import Base from "../layouts/Base.astro";
import { MUSTIKA_COPY } from "../lib/mustika-copy";
---

	<Base title={MUSTIKA_COPY.notFound.title}>
	<div class="not-found">
		<div class="not-found-code">404</div>
		<h1>{MUSTIKA_COPY.notFound.headline}</h1>
		<p>{MUSTIKA_COPY.notFound.body}</p>
		<div class="not-found-actions">
			<a href="/" class="btn btn-primary btn-lg">{MUSTIKA_COPY.notFound.home}</a>
			<a href="/contact" class="btn btn-secondary btn-lg">{MUSTIKA_COPY.notFound.book}</a>
		</div>
	</div>
</Base>

<style>
	.not-found {
		text-align: center;
		padding: 10rem 1rem;
		max-width: 720px;
		margin: 0 auto;
	}

	.not-found-code {
		font-family: var(--font-heading);
		font-size: clamp(7rem, 18vw, 12rem);
		font-weight: 400;
		line-height: 1;
		letter-spacing: -0.035em;
		color: var(--gold-ink);
		margin-bottom: 1.5rem;
	}

	.not-found h1 {
		font-size: clamp(2.2rem, 5vw, 4rem);
		margin-bottom: 1rem;
	}

	.not-found p {
		font-size: 1.05rem;
		color: var(--color-muted);
		margin-bottom: 2rem;
	}

	.not-found-actions {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	@media (max-width: 480px) {
		.not-found-code {
			font-size: 6rem;
		}

		.not-found-actions {
			flex-direction: column;
		}

		.not-found-actions .btn {
			width: 100%;
		}
	}
</style>
