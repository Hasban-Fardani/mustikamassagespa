---
import { MUSTIKA_COPY } from "../lib/mustika-copy";
import { findMustikaCmsNode, getMustikaCmsNodes, readMustikaString } from "../lib/mustika-content";
import { getMustikaTariff } from "../lib/mustika-rates";

interface Props {
	page?: {
		data?: {
			content?: unknown;
		};
	};
}

const { page } = Astro.props;
const copy = MUSTIKA_COPY;

const fallbackBookingHref =
	"https://wa.me/6281222739180?text=Halo%20Mustika%2C%20mau%20booking%20pijat.";
const fallbackBookingNumber = "0812 2273 9180";

const nodes = getMustikaCmsNodes(page?.data?.content);
const findNode = (...types: string[]) => findMustikaCmsNode(nodes, ...types);
const heroNode = findNode("mustika.hero", "marketing.hero");
const bookingNode = findNode("mustika.booking");

const bookingHref = readMustikaString(heroNode?.primaryCtaUrl, fallbackBookingHref);
const bookingNumber = readMustikaString(bookingNode?.phone, fallbackBookingNumber);
const heroSecondaryUrl = readMustikaString(heroNode?.secondaryCtaUrl, "#rituals");
const introLinkUrl = "#rituals";
const faqCtaUrl = readMustikaString(findNode("mustika.faq", "marketing.faq")?.ctaUrl, bookingHref);
const bookingCtaUrl = readMustikaString(bookingNode?.ctaUrl, bookingHref);

const heroHeadline = copy.hero.headline;
const heroEmphasis = copy.hero.emphasis;
const heroSubheadline = copy.hero.subheadline;
const bookingLabel = copy.hero.primaryCta;
const heroSecondaryLabel = copy.hero.secondaryCta;

const heroSlideMeta = copy.heroSlides;
const heroSlides = [
	{
		desktopSrc: "/images/mustika/hero-01-amber-spa.webp",
		mobileSrc: "/images/mustika/hero-01-amber-spa-720.webp",
		...heroSlideMeta[0],
	},
	{
		desktopSrc: "/images/mustika/hero-02-candle-massage.webp",
		mobileSrc: "/images/mustika/hero-02-candle-massage-720.webp",
		...heroSlideMeta[1],
	},
	{
		desktopSrc: "/images/mustika/hero-03-facial-calm.webp",
		mobileSrc: "/images/mustika/hero-03-facial-calm-720.webp",
		...heroSlideMeta[2],
	},
	{
		desktopSrc: "/images/mustika/hero-04-traditional-care.webp",
		mobileSrc: "/images/mustika/hero-04-traditional-care-720.webp",
		...heroSlideMeta[3],
	},
];

const introHeadline = copy.intro.headline;
const introEmphasis = copy.intro.emphasis;
const introBody = copy.intro.body;
const introAudience = [...copy.intro.audience];
const introLinkLabel = copy.intro.linkLabel;

const serviceImagePaths = [
	"/images/mustika/service-traditional.webp?v=20260826-green-uniform",
	"/images/mustika/service-aromatherapy.webp",
	"/images/mustika/service-full-body.webp",
	"/images/mustika/service-wellness.webp",
];
const serviceImageAlts = [
	"Terapis memijat punggung klien di meja pijat",
	"Terapis menuang minyak pijat ke punggung klien",
	"Tangan terapis menekan punggung klien",
	"Wanita berbaring tenang di meja pijat",
];
const services = copy.services.items.map((service, index) => ({
	...service,
	imageSrc: serviceImagePaths[index],
	imageAlt: serviceImageAlts[index],
	tariff: getMustikaTariff(service.title, bookingHref),
}));
const previewService = services[0];

const experienceHeadline = copy.experience.headline;
const experienceEmphasis = copy.experience.emphasis;
const experienceBody = copy.experience.body;
const experienceSteps = copy.experience.steps;

const standardsHeadline = copy.standards.headline;
const standardsEmphasis = copy.standards.emphasis;
const standardsBody = copy.standards.body;
const standardsQuote = copy.standards.quote;
const standards = [...copy.standards.items];

const faqs = copy.faq.items;
const faqHeadline = copy.faq.headline;
const faqBody = copy.faq.body;
const faqCtaLabel = copy.faq.cta;

const bookingHeadline = copy.booking.headline;
const bookingEmphasis = copy.booking.emphasis;
const bookingBody = copy.booking.body;
const bookingCtaLabel = copy.booking.cta;

const splitWords = (value: string) => value.split(/\s+/).filter(Boolean);

---

<div class="mustika-page mustika-ledger">
	<div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>

	<!--
		Narasi & motion map (arc: ketegangan → transisi → antisipasi → pelepasan)
		Hero      : word-mask reveal cepat (expo.out), carousel crossfade, parallax scrub ringan.
		Intro     : PIN + scrub "masuk ke ruang" — foto membuka dari inset, copy mengikuti pelan.
		Rituals   : kartu stagger wipe kiri→kanan + hover micro-interaction (scale halus).
		Experience: langkah berurutan + garis konektor digambar (scaleX) saat masuk viewport.
		Standards : quote paling lambat (jeda emosional), daftar menyapu dari kanan.
		FAQ       : baris terbuka dari bawah (clip), tenang.
		Booking   : "napas keluar" — scale 0.97→1 + rise lambat, tanpa gerakan tajam.
	-->
	<section class="ledger-hero" data-ledger-hero aria-labelledby="hero-title">
		<div class="ledger-hero-main" data-hero-main>
			<div class="shell ledger-hero-grid" data-hero-scene>
				<div class="ledger-copy" data-hero-copy>
					<h1 id="hero-title" class="ledger-title">
						<span class="ledger-title-line" data-hero-line>
							{splitWords(heroHeadline).map((word) => (
								<span class="hero-word-mask"><span data-hero-word>{word}</span></span>
							))}
						</span>
						<span class="ledger-title-line ledger-title-line-accent" data-hero-line>
							<em>
								{splitWords(heroEmphasis).map((word) => (
									<span class="hero-word-mask"><span data-hero-word>{word}</span></span>
								))}
							</em>
						</span>
					</h1>
					<p class="ledger-lede" data-reveal>{heroSubheadline}</p>
					<div class="ledger-actions" data-reveal>
						<a class="ledger-button magnetic" href={bookingHref} target="_blank" rel="noopener noreferrer">
							<span>{bookingLabel}</span>
							<span class="btn-arrow" aria-hidden="true">↗</span>
						</a>
						<a class="ledger-text-link" href={heroSecondaryUrl}>
							<span>{heroSecondaryLabel}</span>
							<span aria-hidden="true">↓</span>
						</a>
					</div>
				</div>

				<figure class="hero-visual" data-hero-stage aria-label="Foto pijat Mustika">
					<div class="hero-visual-frame" data-hero-paper>
						<span class="sr-only-slide-status" data-hero-counter aria-live="polite">{heroSlides[0].label}</span>
						<div
							class="hero-visual-image"
							data-hero-image-wrap
							tabindex="0"
							role="group"
							aria-roledescription="carousel"
							aria-label="Foto pijat"
						>
							{heroSlides.map((slide, index) => (
								<picture
									data-hero-slide
									data-active={index === 0 ? "true" : "false"}
									data-label={slide.label}
									aria-hidden={index === 0 ? "false" : "true"}
								>
									<source media="(max-width: 760px)" srcset={slide.mobileSrc} />
									<img
										src={slide.desktopSrc}
										alt={slide.alt}
										width="1200"
										height="900"
										sizes="(max-width: 760px) calc(100vw - 60px), 560px"
										loading={index === 0 ? "eager" : "lazy"}
										fetchpriority={index === 0 ? "high" : "auto"}
										decoding="async"
									/>
								</picture>
							))}
							<div class="hero-visual-nav">
								<button type="button" data-hero-prev aria-label="Lihat foto sebelumnya">←</button>
								<button type="button" data-hero-next aria-label="Lihat foto berikutnya">→</button>
							</div>
						</div>
					</div>
				</figure>
			</div>
		</div>
	</section>

	<section class="ledger-intro section" aria-labelledby="intro-title">
		<div class="shell ledger-intro-grid">
			<div class="ledger-intro-content">
				<h2 id="intro-title" data-word-reveal>{introHeadline} <em>{introEmphasis}</em></h2>
				<div class="ledger-intro-copy" data-reveal>
					<p data-word-reveal>{introBody}</p>
					<ul class="intro-audience" aria-label="Cocok untuk">
						{introAudience.map((audience) => <li>{audience}</li>)}
					</ul>
					<a class="ledger-inline-link" href={introLinkUrl}><span>{introLinkLabel}</span><span aria-hidden="true">↘</span></a>
				</div>
				<figure class="ledger-intro-media" data-reveal>
					<img
						src="/images/mustika/hero-02-candle-massage.webp"
						alt="Klien berbaring tenang di meja pijat Mustika"
						width="1000"
						height="1250"
						sizes="(max-width: 760px) 100vw, 30vw"
						loading="lazy"
						decoding="async"
					/>
				</figure>
			</div>
		</div>
	</section>

	<section class="ledger-rituals section" id="rituals" aria-labelledby="rituals-title">
		<div class="shell">
			<div class="rituals-heading">
				<h2 id="rituals-title" data-word-reveal>{copy.services.headline} <em>{copy.services.emphasis}</em></h2>
			</div>

			<div class="service-ledger" data-service-list>
				{services.map((service) => (
					<article
						class="service-row"
						data-service-item
						data-service-image={service.imageSrc}
						data-service-title={service.title}
						data-service-tag={service.tag}
					>
						<figure class="service-row-media">
							<img
								src={service.imageSrc}
								alt={service.imageAlt}
								width="900"
								height="1125"
								sizes="(max-width: 760px) 116px, 220px"
								loading="lazy"
								decoding="async"
							/>
						</figure>
						<div class="service-row-copy">
							<span class="service-tag">{service.tag}</span>
							<h3 data-word-reveal>{service.title}</h3>
							<p data-word-reveal>{service.description}</p>
						</div>
						<div class="service-row-end">
							{service.tariff.consultOnly ? (
								<a
									class="service-consult"
									href={service.tariff.consultHref}
									target="_blank"
									rel="noopener noreferrer"
									aria-label={`Tanya ${service.title} via WhatsApp`}
								>
									<span>Kontak kami</span>
									<span aria-hidden="true">↗</span>
								</a>
							) : (
								<ul class="service-rates">
									{service.tariff.rates.map((rate) => (
										<li>
											<a
												class="service-rate"
												href={rate.href}
												target="_blank"
												rel="noopener noreferrer"
												aria-label={`Booking ${service.title} ${rate.minutes} menit, ${rate.priceLabel} via WhatsApp`}
											>
												<span class="service-rate-duration">{rate.minutes} menit</span>
												<span class="service-rate-price">{rate.priceLabel}</span>
											</a>
										</li>
									))}
								</ul>
							)}
						</div>
					</article>
				))}
			</div>
			<div class="service-hover-preview" data-service-preview aria-hidden="true">
				<div class="service-hover-preview-frame">
					<div class="service-hover-preview-media">
						<img
							data-service-preview-image
							src={previewService.imageSrc}
							alt={previewService.imageAlt}
							width="900"
							height="1125"
							loading="lazy"
							decoding="async"
						/>
					</div>
					<div class="service-hover-preview-caption">
						<strong data-service-preview-title>{previewService.title}</strong>
						<span data-service-preview-tag>{previewService.tag}</span>
					</div>
				</div>
			</div>
			<div class="ritual-footer" data-reveal>
				<span>{copy.services.footer}</span>
				<a class="ledger-inline-link ledger-inline-link-light" href={bookingHref} target="_blank" rel="noopener noreferrer"><span>{copy.services.footerCta}</span><span aria-hidden="true">↗</span></a>
			</div>
		</div>
	</section>

	<section class="ledger-experience section" id="experience" aria-labelledby="experience-title">
		<div class="shell">
			<div class="experience-heading">
				<h2 id="experience-title" data-word-reveal>{experienceHeadline} <em>{experienceEmphasis}</em></h2>
				<p data-word-reveal>{experienceBody}</p>
			</div>
			<ol class="journey-track" data-journey-list>
				{experienceSteps.map((step) => (
					<li data-journey-step>
						<span class="journey-rule" aria-hidden="true"></span>
						<h3 data-word-reveal>{step.title}</h3>
						<p data-word-reveal>{step.text}</p>
					</li>
				))}
			</ol>
		</div>
	</section>

	<section class="ledger-standards section" id="standards" aria-labelledby="standards-title">
		<div class="shell standards-layout">
			<div class="standards-grid">
				<div class="standards-copy">
					<h2 id="standards-title" data-word-reveal>{standardsHeadline} <em>{standardsEmphasis}</em></h2>
					<p class="standards-lede" data-word-reveal>{standardsBody}</p>
					<div class="standard-quote" data-reveal>
						<span class="quote-mark" aria-hidden="true">“</span>
						<p data-word-reveal>{standardsQuote}</p>
					</div>
				</div>
				<ul class="standard-ledger" data-standard-list>
					{standards.map((standard) => (
						<li data-standard-item>
							<span>{standard}</span>
							<span class="standard-check" aria-hidden="true">↗</span>
						</li>
					))}
				</ul>
			</div>
		</div>
	</section>

	<section class="ledger-faq section" id="faq" aria-labelledby="faq-title">
		<div class="shell faq-layout">
			<div class="faq-heading">
				<h2 id="faq-title" data-word-reveal>{faqHeadline}</h2>
				<p class="faq-lede" data-word-reveal>{faqBody}</p>
				<a class="ledger-inline-link" href={faqCtaUrl} target="_blank" rel="noopener noreferrer" data-reveal><span>{faqCtaLabel}</span><span aria-hidden="true">↗</span></a>
			</div>
			<div class="faq-ledger" data-faq-list>
				{faqs.map((faq, index) => (
					<article class="faq-row" data-faq-item data-faq-open={index === 0 ? "true" : "false"}>
						<h3 class="faq-question-heading" id={`faq-question-${index + 1}`}>
							<button
								type="button"
								class="faq-question"
								aria-expanded={index === 0 ? "true" : "false"}
								aria-controls={`faq-answer-${index + 1}`}
								data-faq-trigger
							>
								<span class="faq-question-label" data-word-reveal>{faq.question}</span>
								<span class="faq-toggle" aria-hidden="true"><span></span><span></span></span>
							</button>
						</h3>
						<div
							class="faq-answer"
							id={`faq-answer-${index + 1}`}
							role="region"
							aria-labelledby={`faq-question-${index + 1}`}
							data-faq-answer
						>
							<div class="faq-answer-inner"><p>{faq.answer}</p></div>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="ledger-book" id="book" aria-labelledby="book-title">
		<div class="book-visual" data-reveal data-book-visual aria-hidden="true">
			<img src="/images/mustika/mustika-aroma.webp" alt="" width="1000" height="1250" sizes="(max-width: 760px) 70vw, 34rem" loading="lazy" decoding="async" />
			<span class="book-visual-wash"></span>
		</div>
		<div class="shell book-layout">
			<div class="book-index" data-reveal>
					<span>{copy.booking.indexLabel}</span>
				<span>{copy.booking.placeLabel}</span>
			</div>
			<div class="book-copy">
				<h2 id="book-title" data-word-reveal>{bookingHeadline} <em>{bookingEmphasis}</em></h2>
				<p data-word-reveal>{bookingBody}</p>
				<a class="ledger-button ledger-button-light magnetic" href={bookingCtaUrl} target="_blank" rel="noopener noreferrer" data-reveal>
					<span>{bookingCtaLabel}</span>
					<span class="btn-arrow" aria-hidden="true">↗</span>
				</a>
				<span class="book-phone" data-reveal>WhatsApp · {bookingNumber}</span>
			</div>
		</div>
	</section>
</div>

<script>
	import { initMustikaLedgerMotion } from "../scripts/mustika-ledger-motion";

	initMustikaLedgerMotion();
</script>

<style>
	.mustika-ledger {
		--ledger-bone: #f0e9dd;
		--ledger-paper: #f8f4ec;
		--ledger-sage: #d6ded0;
		--ledger-ink: #1c201a;
		--ledger-ink-soft: #2d352d;
		--ledger-oxide: #a94e3b;
		--ledger-oxide-deep: #873c31;
		--ledger-gold: #c49a4e;
		--ledger-muted: #4f5a4f;
		--ledger-line: rgba(28, 32, 26, 0.18);
		--ledger-line-light: rgba(240, 233, 221, 0.26);
		background: var(--ledger-bone);
		color: var(--ledger-ink);
	}

	.mustika-ledger .scroll-progress {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 110;
		width: 100%;
		height: 2px;
		background: var(--ledger-oxide);
		transform: scaleX(0);
		transform-origin: left center;
	}

	/* Screen-reader-only slide announcement; the visual counter is gone. */
	.sr-only-slide-status {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		border: 0;
		clip-path: inset(50%);
		overflow: hidden;
		white-space: nowrap;
	}

	.mustika-ledger .section {
		position: relative;
		padding-block: clamp(5rem, 9vw, 9rem);
	}

	.mustika-ledger > section:not(.ledger-hero) {
		z-index: 1;
	}

	.ledger-hero {
		position: relative;
		height: max(620px, 100svh);
		min-height: 620px;
		background: var(--ledger-bone);
		isolation: isolate;
	}

	.ledger-hero-main {
		position: relative;
		height: 100%;
		z-index: 1;
	}

	.ledger-hero-grid {
		display: grid;
		height: calc(100% - 158px);
		grid-template-columns: minmax(0, 1.02fr) minmax(300px, 0.98fr);
		align-items: center;
		gap: clamp(2.5rem, 7vw, 8rem);
	}

	.ledger-copy {
		position: relative;
		z-index: 2;
		max-width: 640px;
	}

	.book-index {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		color: var(--ledger-muted);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.15em;
		line-height: 1.3;
		text-transform: uppercase;
	}

	.ledger-title {
		max-width: 16ch;
		margin-top: 1rem;
		font-size: clamp(3.1rem, 4.3vw, 5.1rem);
		letter-spacing: -0.02em;
		line-height: 1;
		text-wrap: balance;
	}

	.ledger-title-line {
		display: block;
	}

	.hero-word-mask {
		display: inline-block;
		overflow: clip;
		margin-right: 0.16em;
		padding-bottom: 0.07em;
		vertical-align: bottom;
	}

	.scroll-word-mask {
		display: inline-block;
		overflow: hidden;
		padding-bottom: 0.08em;
		vertical-align: bottom;
	}

	[data-scroll-word-inner] {
		display: inline-block;
		will-change: transform, opacity;
	}

	.ledger-title-line-accent {
		color: var(--ledger-oxide);
	}

	/* Italic serif is reserved for the hero accent line alone -- one gesture,
	 * not a repeated section device. */
	.ledger-title em {
		font-style: italic;
	}

	.ledger-lede {
		max-width: 38ch;
		margin-top: 1.8rem;
		color: var(--ledger-muted);
		font-size: 0.97rem;
		line-height: 1.6;
	}

	.ledger-actions {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 1.25rem;
		margin-top: 1.9rem;
	}

	.ledger-button {
		display: inline-flex;
		min-height: 50px;
		align-items: center;
		justify-content: center;
		gap: 0.85rem;
		padding: 0 1.25rem;
		border: 1px solid var(--ledger-oxide);
		background: var(--ledger-oxide);
		color: var(--ledger-paper);
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		line-height: 1;
		text-transform: uppercase;
		transition: background-color 220ms ease, border-color 220ms ease, color 220ms ease;
	}

	.ledger-button:hover {
		border-color: var(--ledger-oxide-deep);
		background: var(--ledger-oxide-deep);
	}

	.ledger-text-link,
	.ledger-inline-link {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		width: fit-content;
		border-bottom: 1px solid currentColor;
		padding-bottom: 0.32rem;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		line-height: 1.3;
		text-transform: uppercase;
		transition: color 220ms ease, gap 320ms var(--ease-out-quint);
	}

	.ledger-text-link:hover,
	.ledger-inline-link:hover {
		gap: 0.95rem;
	}

	.ledger-text-link,
	.ledger-inline-link {
		color: var(--ledger-ink);
	}

	.hero-visual {
		position: relative;
		width: min(100%, 560px);
		aspect-ratio: 1.04;
		justify-self: end;
		margin: 0;
		perspective: 1200px;
	}

	.hero-visual-frame {
		position: absolute;
		inset: 0;
		display: grid;
		grid-template-rows: minmax(0, 1fr);
		padding: clamp(0.95rem, 1.8vw, 1.35rem);
		border: 1px solid var(--ledger-line);
		background: var(--ledger-paper);
		box-shadow: 16px 18px 0 rgba(196, 154, 78, 0.13);
		transform: rotate(0deg);
		transform-origin: 50% 50%;
	}

	.hero-visual-nav {
		position: absolute;
		left: clamp(0.85rem, 2vw, 1.35rem);
		bottom: clamp(0.85rem, 2.2vw, 1.5rem);
		z-index: 5;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}

	.hero-visual-nav button {
		display: grid;
		width: 2.4rem;
		height: 2.4rem;
		border: 0;
		border-radius: 999px;
		background: rgba(22, 16, 12, 0.42);
		color: var(--ledger-paper);
		font: inherit;
		line-height: 1;
		place-items: center;
		backdrop-filter: blur(10px);
		transition: color 180ms ease, transform 260ms var(--ease-out-quint), background 180ms ease;
	}

	.hero-visual-nav button:hover,
	.hero-visual-nav button:focus-visible {
		background: rgba(22, 16, 12, 0.68);
		color: var(--ledger-paper);
	}

	.hero-visual-nav button:first-child:hover {
		transform: translateX(-2px);
	}

	.hero-visual-nav button:last-child:hover {
		transform: translateX(2px);
	}


	.hero-visual-image {
		position: relative;
		min-height: 0;
		margin-block: 0.95rem 1rem;
		overflow: hidden;
		background: var(--ledger-ink);
		isolation: isolate;
		outline: none;
	}

	.hero-visual-image:focus-visible {
		box-shadow: 0 0 0 2px var(--ledger-paper), 0 0 0 4px var(--ledger-oxide);
	}

	.hero-visual-image::before,
	.hero-visual-image::after {
		position: absolute;
		z-index: 3;
		content: "";
		pointer-events: none;
	}

	.hero-visual-image::before {
		inset: 0;
		border: 1px solid rgba(240, 233, 221, 0.3);
	}

	.hero-visual-image::after {
		top: 1rem;
		right: 1rem;
		width: 3.2rem;
		height: 3.2rem;
		border-top: 1px solid var(--ledger-gold);
		border-right: 1px solid var(--ledger-gold);
	}

	.hero-visual-image picture {
		position: absolute;
		inset: 0;
		display: block;
		opacity: 0;
		visibility: hidden;
		transition: opacity 650ms ease, visibility 650ms ease;
	}

	.hero-visual-image picture[data-active="true"] {
		opacity: 1;
		visibility: visible;
	}

	.hero-visual-image img {
		display: block;
		width: 100%;
		height: 100%;
	}

	.hero-visual-image img {
		object-fit: cover;
		object-position: 50% 22%;
		transform: scale(1.04);
		will-change: transform;
	}


	@media (max-width: 480px) {
		.hero-visual-nav {
			gap: 0.2rem;
		}

		.hero-visual-nav button {
			width: 2.35rem;
			height: 2.35rem;
		}
	}

	/* Sage surfaces sit between bone and ink; the shared muted tone drops
	 * below AA there, so those sections get a deeper companion tone. */
	.ledger-intro,
	.ledger-faq {
		--ledger-muted: #4a544b;
	}

	.ledger-intro {
		background: var(--ledger-sage);
	}

	.ledger-intro-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: clamp(2rem, 7vw, 9rem);
	}

	.ledger-intro-content h2 {
		max-width: 13ch;
		font-size: clamp(3.3rem, 6.2vw, 7rem);
		letter-spacing: -0.02em;
		line-height: 0.9;
	}

	.ledger-intro-content h2 em {
		color: var(--ledger-oxide);
	}

	.ledger-intro-copy {
		display: grid;
		gap: 1.3rem;
		align-content: start;
		margin-top: clamp(2.25rem, 5vw, 4rem);
		border-top: 1px solid var(--ledger-line);
		padding-top: 1.35rem;
	}

	.ledger-intro-copy > p {
		max-width: 37ch;
		margin: 0;
		color: var(--ledger-ink-soft);
		font-size: 0.95rem;
	}

	.intro-audience {
		display: grid;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 0.79rem;
		font-weight: 700;
	}

	.intro-audience li::before {
		margin-right: 0.65rem;
		color: var(--ledger-oxide);
		content: "•";
	}

	.ledger-inline-link-light {
		color: var(--ledger-paper);
	}

	.ledger-rituals {
		background: var(--ledger-ink);
		color: var(--ledger-paper);
	}

	.rituals-heading {
		display: block;
		margin-block: clamp(3.25rem, 6vw, 6rem) clamp(3rem, 5vw, 4rem);
	}

	.rituals-heading h2 {
		max-width: 11ch;
		font-size: clamp(3.4rem, 6.5vw, 7.4rem);
		letter-spacing: -0.02em;
		line-height: 0.88;
	}

	.rituals-heading h2 em {
		color: var(--ledger-gold);
	}

	.service-ledger {
		border-top: 1px solid var(--ledger-line-light);
	}

	.service-row {
		display: grid;
		grid-template-columns: clamp(120px, 16vw, 200px) minmax(0, 1fr) auto;
		gap: clamp(1.25rem, 3vw, 2.5rem);
		align-items: stretch;
		min-height: 142px;
		border-bottom: 1px solid var(--ledger-line-light);
		transition: background-color 300ms ease;
	}

	.service-row:hover {
		background: rgba(240, 233, 221, 0.055);
	}

	.service-hover-preview {
		--preview-gold: #c49a4e;
		position: fixed;
		top: 0;
		left: 0;
		z-index: 120;
		width: min(27vw, 390px);
		min-width: 270px;
		pointer-events: none;
		visibility: hidden;
		opacity: 0;
		will-change: transform, opacity;
	}

	/* The card renders on an ink field wherever it lives (in-page or portal),
	 * so its text tones are light here -- scoped overrides cannot follow the
	 * portal outside .mustika-ledger. */
	.service-hover-preview-frame {
		padding: 0.7rem;
		border: 1px solid rgba(248, 244, 236, 0.3);
		background: #20271f;
		box-shadow: 0 28px 80px rgba(0, 0, 0, 0.32);
		color: #f7f2e9;
	}

	.service-hover-preview-caption {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.service-hover-preview-media {
		aspect-ratio: 0.8;
		overflow: hidden;
		background: #2d352d;
	}

	.service-hover-preview-media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: saturate(1.12) contrast(1.06) sepia(0.06);
		will-change: transform;
	}

	.service-hover-preview-caption {
		align-items: flex-end;
		padding: 0.75rem 0.1rem 0.05rem;
	}

	.service-hover-preview-caption strong {
		font-family: var(--font-heading);
		font-size: clamp(1.15rem, 1.8vw, 1.7rem);
		font-weight: 500;
		letter-spacing: -0.02em;
		line-height: 0.95;
	}

	.service-hover-preview-caption span {
		max-width: 12ch;
		color: rgba(247, 242, 233, 0.64);
		font-size: 0.62rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		line-height: 1.25;
		text-align: right;
		text-transform: uppercase;
	}

	.service-tag {
		max-width: 26ch;
		color: rgba(240, 233, 221, 0.66);
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		line-height: 1.4;
	}

	.service-row-copy {
		display: grid;
		align-content: center;
		gap: 0.55rem;
		min-width: 0;
		padding-block: 1.3rem;
	}

	.service-row-media {
		position: relative;
		align-self: stretch;
		min-height: 130px;
		margin: 0;
		overflow: hidden;
		background: var(--ledger-ink-soft);
		isolation: isolate;
	}

	.service-row-media::after {
		position: absolute;
		inset: 0;
		border: 1px solid rgba(240, 233, 221, 0.2);
		content: "";
		pointer-events: none;
	}

	.service-row-media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: saturate(1.08) contrast(1.05) sepia(0.05);
		transition: filter 600ms ease, transform 700ms var(--ease-out-quint);
	}

	.service-row:hover .service-row-media img {
		filter: saturate(1.18) contrast(1.08) sepia(0.04);
		transform: scale(1.035);
	}

	.service-row-copy h3 {
		font-size: clamp(1.9rem, 3.8vw, 4.2rem);
		letter-spacing: -0.02em;
		line-height: 0.95;
	}

	.service-row-copy p {
		max-width: 42ch;
		margin: 0;
		color: rgba(240, 233, 221, 0.61);
		font-size: 0.82rem;
		line-height: 1.5;
	}

	.service-row-end {
		position: relative;
		z-index: 130;
		display: flex;
		align-items: center;
		justify-content: flex-end;
		min-width: 12.5rem;
		padding-block: 1.2rem;
		padding-inline-end: 0.15rem;
	}

	.service-rates {
		display: grid;
		gap: 0.42rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.service-rate,
	.service-consult {
		display: grid;
		grid-template-columns: 5.4rem minmax(6.5rem, auto);
		align-items: baseline;
		column-gap: 1rem;
		color: inherit;
	}

	.service-consult {
		grid-template-columns: auto auto;
		align-items: center;
		column-gap: 0.55rem;
		color: var(--ledger-gold);
		font-family: var(--font-heading);
		font-size: 1.15rem;
		letter-spacing: -0.02em;
		line-height: 1;
	}

	.service-rate-duration {
		color: rgba(240, 233, 221, 0.52);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		line-height: 1.2;
	}

	.service-rate-price {
		color: var(--ledger-gold);
		font-family: var(--font-heading);
		font-size: clamp(1.05rem, 1.5vw, 1.35rem);
		font-variant-numeric: tabular-nums;
		letter-spacing: -0.03em;
		line-height: 1;
		text-align: right;
	}

	.service-rate:hover .service-rate-price,
	.service-consult:hover {
		color: var(--ledger-paper);
	}

	.ritual-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 1.2rem;
		color: rgba(240, 233, 221, 0.55);
		font-size: 0.76rem;
	}

	.ledger-experience {
		background: var(--ledger-oxide);
		color: var(--ledger-paper);
	}

	.experience-heading {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 0.85rem;
		align-items: start;
		margin-block: clamp(3rem, 6vw, 6rem);
		max-width: 42rem;
	}

	.experience-heading h2 {
		max-width: 11ch;
		font-size: clamp(3.6rem, 7vw, 8rem);
		letter-spacing: -0.02em;
		line-height: 0.85;
	}

	.experience-heading h2 em {
		color: var(--ledger-ink);
	}

	.experience-heading > p {
		max-width: 46ch;
		margin-top: 0;
		color: rgba(248, 244, 236, 0.82);
		font-size: 1.05rem;
		line-height: 1.45;
	}

	.journey-track {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.journey-track li {
		display: grid;
		gap: 0.45rem;
		align-content: start;
		padding-right: clamp(1rem, 3vw, 2.2rem);
	}

	/* Connector rule between steps; drawn with scaleX by the motion script. */
	.journey-rule {
		display: block;
		height: 1px;
		margin-bottom: 1.1rem;
		background: rgba(248, 244, 236, 0.3);
		transform-origin: left center;
	}

	.journey-track li:not(:last-child) {
		margin-right: clamp(1rem, 4vw, 4rem);
	}

	.journey-track h3 {
		margin-top: 0;
		font-size: clamp(1.65rem, 2.7vw, 2.8rem);
		letter-spacing: -0.02em;
		line-height: 0.95;
	}

	.journey-track p {
		max-width: 25ch;
		margin-top: 0;
		color: rgba(248, 244, 236, 0.68);
		font-size: 0.83rem;
	}

	.ledger-standards {
		background: var(--ledger-bone);
	}

	.standards-grid {
		display: grid;
		grid-template-columns: minmax(0, 0.92fr) minmax(300px, 0.72fr);
		gap: clamp(3rem, 10vw, 10rem);
		align-items: start;
	}

	.standards-copy h2 {
		max-width: 12ch;
		font-size: clamp(3.25rem, 6.1vw, 7rem);
		letter-spacing: -0.02em;
		line-height: 0.87;
	}

	.standards-copy h2 em {
		color: var(--ledger-oxide);
	}

	.standards-lede {
		max-width: 37ch;
		margin-top: 1.8rem;
		color: var(--ledger-muted);
		font-size: 0.93rem;
	}

	.standard-quote {
		display: grid;
		grid-template-columns: 2rem minmax(0, 1fr);
		gap: 0.75rem;
		max-width: 35rem;
		margin-top: clamp(3rem, 6vw, 5rem);
		border-top: 1px solid var(--ledger-line);
		padding-top: 1.1rem;
	}

	.quote-mark {
		color: var(--ledger-oxide);
		font-family: var(--font-heading);
		font-size: 2.7rem;
		line-height: 0.72;
	}

	.standard-quote p {
		max-width: 23ch;
		font-family: var(--font-heading);
		font-size: clamp(1.35rem, 2.1vw, 2rem);
		line-height: 1.35;
	}

	.standard-ledger,
	.faq-ledger {
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--ledger-line);
	}

	.standard-ledger li {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 1rem;
		align-items: center;
		min-height: 92px;
		border-bottom: 1px solid var(--ledger-line);
		font-family: var(--font-heading);
		font-size: clamp(1.45rem, 2.45vw, 2.65rem);
		letter-spacing: -0.02em;
		line-height: 0.95;
	}

	.standard-check {
		color: var(--ledger-oxide);
		font-family: var(--font-body);
		font-size: 1rem;
	}

	.ledger-faq {
		background: var(--ledger-sage);
	}

	.faq-layout {
		display: grid;
		grid-template-columns: minmax(230px, 0.6fr) minmax(0, 1fr);
		gap: clamp(3rem, 9vw, 9rem);
		align-items: start;
	}

	.faq-heading h2 {
		max-width: 11ch;
		font-size: clamp(3.2rem, 5.4vw, 6.4rem);
		letter-spacing: -0.02em;
		line-height: 0.88;
	}

	.faq-heading > p {
		max-width: 29ch;
		margin-top: 1.8rem;
		color: var(--ledger-muted);
		font-size: 0.9rem;
	}

	.faq-heading > .ledger-inline-link {
		margin-top: 1.7rem;
	}

	.faq-row {
		border-bottom: 1px solid var(--ledger-line);
	}

	.faq-question-heading {
		margin: 0;
	}

	.faq-question {
		display: grid;
		width: 100%;
		grid-template-columns: minmax(0, 1fr) 2.25rem;
		gap: 1rem;
		align-items: start;
		padding: 1.55rem 0;
		border: 0;
		background: transparent;
		color: var(--ledger-ink);
		font: inherit;
		text-align: left;
		cursor: pointer;
	}

	.faq-question-label {
		font-family: var(--font-heading);
		font-size: clamp(1.35rem, 2vw, 2rem);
		letter-spacing: -0.015em;
		line-height: 1.05;
		transition: color 260ms ease, transform 420ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.faq-question:hover .faq-question-label,
	.faq-question:focus-visible .faq-question-label {
		color: var(--ledger-oxide-deep);
		transform: translateX(0.25rem);
	}

	.faq-question:focus-visible {
		outline: 2px solid var(--ledger-oxide);
		outline-offset: 0.4rem;
	}

	.faq-toggle {
		position: relative;
		display: grid;
		width: 2.25rem;
		height: 2.25rem;
		place-items: center;
		border: 1px solid var(--ledger-line);
		border-radius: 50%;
		color: var(--ledger-oxide-deep);
		transition: border-color 320ms ease, background-color 320ms ease, color 320ms ease, transform 520ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.faq-toggle span {
		position: absolute;
		width: 0.7rem;
		height: 1px;
		background: currentColor;
	}

	.faq-toggle span:last-child {
		transform: rotate(90deg);
	}

	.faq-question:hover .faq-toggle,
	.faq-question:focus-visible .faq-toggle {
		border-color: var(--ledger-oxide-deep);
		background: var(--ledger-oxide-deep);
		color: var(--ledger-paper);
	}

	.faq-row[data-faq-open="true"] .faq-toggle {
		transform: rotate(45deg);
	}

	.faq-answer {
		display: grid;
		grid-template-rows: 1fr;
		padding-right: 3.25rem;
		opacity: 1;
		transition: grid-template-rows 520ms cubic-bezier(0.16, 1, 0.3, 1), opacity 260ms ease;
	}

	.faq-answer-inner {
		min-height: 0;
		overflow: hidden;
	}

	.faq-answer p {
		max-width: 55ch;
		margin: 0;
		padding: 0 0 1.55rem;
		color: var(--ledger-muted);
		font-size: 0.9rem;
		line-height: 1.6;
	}

	.mustika-page.faq-ready .faq-answer {
		grid-template-rows: 0fr;
		opacity: 0;
	}

	.mustika-page.faq-ready .faq-row[data-faq-open="true"] .faq-answer {
		grid-template-rows: 1fr;
		opacity: 1;
	}

	.ledger-book {
		position: relative;
		background: var(--ledger-ink);
		color: var(--ledger-paper);
		isolation: isolate;
	}

	.book-visual {
		position: absolute;
		z-index: 0;
		top: 12%;
		right: 3%;
		width: min(25vw, 30rem);
		height: 72%;
		overflow: hidden;
		border: 1px solid rgba(196, 154, 78, 0.5);
		background: var(--ledger-ink-soft);
		box-shadow: 16px 18px 0 rgba(196, 154, 78, 0.08);
		transform: rotate(1.5deg);
		pointer-events: none;
		will-change: transform, opacity;
	}

	.book-visual img,
	.book-visual-wash {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.book-visual img {
		display: block;
		object-fit: cover;
		filter: saturate(1.1) contrast(1.06) sepia(0.08) brightness(0.98);
		transform: scale(1.03);
	}

	.book-visual-wash {
		background: linear-gradient(180deg, rgba(28, 32, 26, 0.04), rgba(28, 32, 26, 0.3)), linear-gradient(90deg, rgba(28, 32, 26, 0.72) 0%, rgba(28, 32, 26, 0.22) 24%, rgba(28, 32, 26, 0) 54%);
	}

	.ledger-book::before,
	.ledger-book::after {
		position: absolute;
		content: "";
		pointer-events: none;
	}

	.ledger-book::before {
		top: 10%;
		right: 2.5%;
		width: min(25vw, 30rem);
		height: 72%;
		border: 1px solid rgba(196, 154, 78, 0.24);
		transform: rotate(3.5deg);
	}

	.ledger-book::after {
		display: none;
	}

	.book-layout {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: minmax(170px, 0.38fr) minmax(0, 1fr);
		gap: clamp(2rem, 9vw, 9rem);
		align-items: start;
		padding-block: clamp(5rem, 10vw, 10rem);
	}

	.book-index {
		align-items: flex-start;
		flex-direction: column;
		color: rgba(240, 233, 221, 0.55);
	}

	.book-index span:first-child {
		color: var(--ledger-gold);
	}

	.book-copy {
		max-width: min(100%, clamp(26rem, 35vw, 42rem));
	}

	.book-copy h2 {
		max-width: 11ch;
		font-size: clamp(3.7rem, 6.2vw, 7.4rem);
		letter-spacing: -0.02em;
		line-height: 0.84;
	}

	.book-copy h2 em {
		color: var(--ledger-oxide);
	}

	.book-copy > p {
		max-width: 32ch;
		margin-top: 1.8rem;
		color: rgba(240, 233, 221, 0.66);
		font-size: 0.92rem;
	}

	.ledger-button-light {
		margin-top: 2rem;
		border-color: var(--ledger-gold);
		background: var(--ledger-gold);
		color: var(--ledger-ink);
	}

	.ledger-button-light:hover {
		border-color: var(--ledger-paper);
		background: var(--ledger-paper);
		color: var(--ledger-ink);
	}

	.book-phone {
		display: block;
