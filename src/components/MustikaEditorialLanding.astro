---
import {
	findMustikaCmsNode,
	getMustikaCmsNodes,
	readMustikaRecords,
	readMustikaString,
	readMustikaStringList,
} from "../lib/mustika-content";

interface Props {
	page?: {
		data?: {
			content?: unknown;
		};
	};
}

const { page } = Astro.props;

const fallbackBookingHref =
	"https://wa.me/6281222739180?text=Halo%20Mustika%2C%20saya%20ingin%20booking%20sesi%20massage.";
const fallbackBookingNumber = "0812 2273 9180";

const fallbackServices = [
	{
		number: "01",
		title: "Traditional Massage",
		description: "Pijat tradisional untuk melepas pegal setelah hari yang panjang.",
		tag: "Untuk badan yang pegal",
	},
	{
		number: "02",
		title: "Aromatherapy Massage",
		description: "Sentuhan lembut dengan aroma yang membantu suasana terasa lebih tenang.",
		tag: "Untuk suasana yang tenang",
	},
	{
		number: "03",
		title: "Full Body Massage",
		description: "Pijat seluruh tubuh ketika rasanya semua bagian perlu diperhatikan.",
		tag: "Untuk perhatian menyeluruh",
	},
	{
		number: "04",
		title: "Wellness Therapy",
		description: "Sesi yang disesuaikan dengan kebutuhan tubuh.",
		tag: "Untuk kebutuhan yang lebih personal",
	},
];

const fallbackExperienceSteps = [
	{
		number: "01",
		title: "Ceritakan kebutuhan",
		text: "Ceritakan bagian tubuh yang terasa paling membutuhkan perhatian.",
	},
	{
		number: "02",
		title: "Kami sesuaikan sesi",
		text: "Terapis membantu menyesuaikan pilihan perawatan dengan kebutuhan.",
	},
	{
		number: "03",
		title: "Nikmati waktu setelahnya",
		text: "Selesai sesi, beri tubuh waktu untuk beristirahat sebelum kembali beraktivitas.",
	},
];

const fallbackStandards = [
	"Terapis profesional",
	"Pengalaman yang personal",
	"Ruang bersih dan nyaman",
	"Untuk tubuh dan pikiran",
];

const fallbackFaqs = [
	{
		question: "Bagaimana cara booking sesi?",
		answer: "Kirim pesan ke WhatsApp Mustika di 0812 2273 9180. Sertakan layanan dan waktu yang Anda inginkan; admin akan mengonfirmasi ketersediaannya.",
	},
	{
		question: "Apakah Mustika menerima pelanggan umum dan keluarga?",
		answer: "Ya. Mustika melayani pelanggan umum maupun keluarga. Sampaikan kebutuhan khusus saat booking agar kami bisa membantu menyiapkan sesi yang sesuai.",
	},
	{
		question: "Sesi apa saja yang bisa dipilih?",
		answer: "Tersedia pijat tradisional, pijat aromaterapi, pijat seluruh tubuh, dan wellness therapy. Jika masih ragu, admin bisa membantu memilihkan sesi.",
	},
	{
		question: "Di mana lokasi Mustika?",
		answer: "Mustika Massage Spa berada di Bandung, Jawa Barat. Minta detail alamat dan arah perjalanan melalui WhatsApp saat booking.",
	},
];

const nodes = getMustikaCmsNodes(page?.data?.content);
const findNode = (...types: string[]) => findMustikaCmsNode(nodes, ...types);
const readString = readMustikaString;
const readStringList = readMustikaStringList;

const heroNode = findNode("mustika.hero", "marketing.hero");
const introNode = findNode("mustika.intro");
const servicesNode = findNode("mustika.services", "marketing.features");
const experienceNode = findNode("mustika.experience");
const standardsNode = findNode("mustika.standards");
const faqNode = findNode("mustika.faq", "marketing.faq");
const bookingNode = findNode("mustika.booking");

const heroHeadline = readString(heroNode?.headline, "Pijat profesional untuk");
const heroEmphasis = readString(heroNode?.emphasis, "tubuh yang butuh jeda.");
const heroSubheadline = readString(
	heroNode?.subheadline,
	"Sampaikan bagian tubuh yang terasa pegal. Kami bantu pilihkan sesi yang sesuai di Bandung.",
);
const bookingHref = readString(heroNode?.primaryCtaUrl, fallbackBookingHref);
const bookingLabel = readString(heroNode?.primaryCtaLabel, "Booking via WhatsApp");
const heroSecondaryLabel = readString(heroNode?.secondaryCtaLabel, "Lihat ritual kami");
const heroSecondaryUrl = readString(heroNode?.secondaryCtaUrl, "#rituals");
const bookingNumber = readString(bookingNode?.phone, fallbackBookingNumber);

const introHeadline = readString(introNode?.headline, "Tubuh tidak selalu minta lebih.");
const introEmphasis = readString(introNode?.emphasis, "Kadang ia minta jeda.");
const introBody = readString(
	introNode?.body,
	"Mustika memberi ruang untuk melepas pegal dan menenangkan pikiran. Pilih sesi yang sesuai, lalu biarkan tubuh beristirahat.",
);
const introAudience = readStringList(introNode?.audience, [
	"Badan terasa pegal setelah aktivitas",
	"Ingin istirahat tanpa terburu-buru",
	"Mencari sesi untuk keluarga",
]);
const introLinkLabel = readString(introNode?.linkLabel, "Lihat pilihan perawatan");
const introLinkUrl = readString(introNode?.linkUrl, "#rituals");

const rawServices = readMustikaRecords(servicesNode?.features);
const serviceImagePaths = [
	"/images/mustika/mustika-hero.webp",
	"/images/mustika/mustika-aroma.webp",
	"/images/mustika/mustika-space.webp",
	"/images/mustika/mustika-reflex.webp",
];
const services = rawServices.length
	? rawServices.map((service, index) => ({
			number: String(index + 1).padStart(2, "0"),
			title: readString(service.title, fallbackServices[index]?.title || "Massage & wellness"),
			description: readString(service.description),
			tag: readString(service.tag, fallbackServices[index]?.tag || "Untuk kebutuhan tubuh"),
			imageSrc: serviceImagePaths[index % serviceImagePaths.length],
		}))
	: fallbackServices.map((service, index) => ({
		...service,
		imageSrc: serviceImagePaths[index],
	}));

	const experienceHeadline = readString(experienceNode?.headline, "Datang dengan lelah.");
const experienceEmphasis = readString(experienceNode?.emphasis, "Pulang lebih ringan.");
const experienceBody = readString(
	experienceNode?.body,
	"Ceritakan bagian tubuh yang terasa pegal. Terapis menyesuaikan sesi dengan kebutuhan Anda.",
);
const rawExperienceSteps = readMustikaRecords(experienceNode?.steps);
const experienceSteps = rawExperienceSteps.length
	? rawExperienceSteps.map((step, index) => ({
			number: readString(step.number, String(index + 1).padStart(2, "0")),
			title: readString(step.title),
			text: readString(step.text),
		}))
	: fallbackExperienceSteps;

const standardsHeadline = readString(standardsNode?.headline, "Hal kecil yang kami perhatikan");
const standardsEmphasis = readString(standardsNode?.emphasis, "sejak awal.");
const standardsBody = readString(
	standardsNode?.body,
	"Dari sapaan pertama hingga waktu untuk pulang, kami ingin sesi terasa tenang dan personal.",
);
const standardsQuote = readString(
	standardsNode?.quote,
	"Kalau ada bagian yang terasa kurang nyaman, beri tahu kami. Sesi bisa disesuaikan.",
);
const standards = readStringList(standardsNode?.items, fallbackStandards);

const rawFaqs = readMustikaRecords(faqNode?.items);
const faqs = rawFaqs.length
	? rawFaqs.map((faq) => ({ question: readString(faq.question), answer: readString(faq.answer) }))
	: fallbackFaqs;
const faqHeadline = readString(faqNode?.headline, "Sebelum datang, simak jawabannya.");
const faqBody = readString(
	faqNode?.body,
	"Belum menemukan yang Anda cari? Tanya admin Mustika melalui WhatsApp.",
);
const faqCtaLabel = readString(faqNode?.ctaLabel, "Tanya admin Mustika");
const faqCtaUrl = readString(faqNode?.ctaUrl, bookingHref);

const bookingHeadline = readString(bookingNode?.headline, "Satu pesan kecil.");
const bookingEmphasis = readString(bookingNode?.emphasis, "Waktu untuk beristirahat.");
const bookingBody = readString(
	bookingNode?.body,
	"Chat Mustika untuk memilih sesi dan waktu yang sesuai di Bandung.",
);
	const bookingCtaLabel = readString(bookingNode?.ctaLabel, "Booking via WhatsApp");
const bookingCtaUrl = readString(bookingNode?.ctaUrl, bookingHref);
const heroLocation = readString(heroNode?.location, "Bandung, Jawa Barat");
const heroAudience = readString(heroNode?.audienceLabel, "Untuk pelanggan umum dan keluarga");

const splitWords = (value: string) => value.split(/\s+/).filter(Boolean);
---

<div class="mustika-page mustika-ledger">
	<div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>

	<section class="ledger-hero" data-ledger-hero aria-labelledby="hero-title">
		<div class="ledger-hero-main" data-hero-main>
			<div class="shell ledger-hero-top" data-hero-top>
				<span class="ledger-overline">Mustika / Massage Spa</span>
			</div>

			<div class="shell ledger-hero-grid" data-hero-scene>
				<div class="ledger-copy" data-hero-copy>
					<h1 id="hero-title" class="ledger-title">
						<span class="ledger-title-line" data-hero-line>
							{splitWords(heroHeadline).map((word) => (
								<span class="hero-word-mask"><span data-hero-word>{word}</span></span>
							))}
						</span>
						<span class="ledger-title-line ledger-title-line-accent" data-hero-line>
							<em>
								{splitWords(heroEmphasis).map((word) => (
									<span class="hero-word-mask"><span data-hero-word>{word}</span></span>
								))}
							</em>
						</span>
					</h1>
					<div class="ledger-index" data-reveal>
						<span class="ledger-index-number" data-hero-index>01</span>
						<span class="ledger-index-rule" aria-hidden="true"></span>
						<span>Ritual pertama</span>
					</div>
					<p class="ledger-lede" data-reveal>{heroSubheadline}</p>
					<div class="ledger-actions" data-reveal>
						<a class="ledger-button magnetic" href={bookingHref} target="_blank" rel="noopener noreferrer">
							<span>{bookingLabel}</span>
							<span class="btn-arrow" aria-hidden="true">↗</span>
						</a>
						<a class="ledger-text-link" href={heroSecondaryUrl}>
							<span>{heroSecondaryLabel}</span>
							<span aria-hidden="true">↓</span>
						</a>
					</div>
					<div class="ledger-meta" data-reveal>
						<span>{heroLocation}</span>
						<span class="ledger-meta-separator" aria-hidden="true">/</span>
						<span>{heroAudience}</span>
					</div>
				</div>

				<figure class="hero-visual" data-hero-stage aria-label="Suasana pijat dan wellness di Mustika">
					<div class="hero-visual-frame" data-hero-paper>
						<div class="hero-visual-meta">
							<span>Ruang perawatan</span>
							<span>01 / 04</span>
						</div>
						<div class="hero-visual-rule" data-hero-sheet-rule aria-hidden="true"></div>
						<div class="hero-visual-image" data-hero-image-wrap>
							<picture>
								<source media="(max-width: 760px)" srcset="/images/mustika/mustika-hero-720.webp" />
								<img
									src="/images/mustika/mustika-hero.webp"
									alt="Terapis memberikan pijat relaksasi pada pelanggan di ruang wellness"
									width="1600"
									height="1067"
									sizes="(max-width: 760px) calc(100vw - 60px), 560px"
									loading="eager"
									fetchpriority="high"
									decoding="async"
								/>
							</picture>
						</div>
						<div class="hero-visual-detail" data-hero-visual-detail>
							<span class="hero-visual-detail-index">01</span>
							<p>Ruang tenang untuk melepas pegal.</p>
						</div>
					</div>
				</figure>
			</div>
		</div>

		<div class="ledger-hero-exit" data-hero-exit>
			<div class="hero-exit-visual" data-hero-exit-visual aria-hidden="true">
				<img
					src="/images/mustika/mustika-reflex.webp"
					alt=""
					width="600"
					height="901"
					sizes="(max-width: 1000px) 34vw, 32rem"
					loading="lazy"
					decoding="async"
				/>
				<span class="hero-exit-visual-wash"></span>
			</div>
			<div class="shell hero-exit-inner" data-hero-exit-inner>
				<span class="ledger-overline ledger-overline-light">02 / Masuk ke ritual</span>
				<h2>
					<span class="hero-exit-line">
						<span class="hero-word-mask"><span data-hero-exit-word>Sisihkan</span></span>
						<span class="hero-word-mask"><span data-hero-exit-word>sebentar.</span></span>
					</span>
					<br />
					<em class="hero-exit-line">
						<span class="hero-word-mask"><span data-hero-exit-word>Rasakan</span></span>
						<span class="hero-word-mask"><span data-hero-exit-word>bedanya.</span></span>
					</em>
				</h2>
				<a class="hero-exit-link" href="#rituals"><span>Temukan layanan Mustika</span><span aria-hidden="true">↓</span></a>
			</div>
		</div>
	</section>

	<section class="ledger-intro section" aria-labelledby="intro-title">
		<div class="shell ledger-intro-grid">
			<div class="section-marker" data-reveal>
				<span>01</span>
				<span>Ruang untuk jeda</span>
			</div>
			<div class="ledger-intro-content">
				<h2 id="intro-title" data-word-reveal>{introHeadline} <em>{introEmphasis}</em></h2>
				<div class="ledger-intro-detail" data-reveal>
					<p data-word-reveal>{introBody}</p>
					<div class="intro-side-column">
						<span class="detail-label">Cocok untuk</span>
						<ul class="intro-audience" aria-label="Cocok untuk">
							{introAudience.map((audience) => <li>{audience}</li>)}
						</ul>
						<a class="ledger-inline-link" href={introLinkUrl}><span>{introLinkLabel}</span><span aria-hidden="true">↘</span></a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="ledger-rituals section" id="rituals" aria-labelledby="rituals-title">
		<div class="shell">
			<div class="section-bar section-bar-light" data-reveal>
				<span>02 / Ritual</span>
			</div>
			<div class="rituals-heading">
				<h2 id="rituals-title" data-word-reveal>{readString(servicesNode?.headline, "Temukan cara tubuh ingin")} <em>{readString(servicesNode?.emphasis, "dipulihkan.")}</em></h2>
			</div>

			<div class="service-ledger" data-service-list>
				{services.map((service) => (
					<article class="service-row" data-service-item>
						<div class="service-row-top">
							<span class="service-number">{service.number}</span>
							<span class="service-tag">{service.tag}</span>
					</div>
					<div class="service-row-copy">
						<div class="service-row-media">
							<img src={service.imageSrc} alt={`Ilustrasi editorial untuk ${service.title}`} width="600" height="901" sizes="(max-width: 760px) 92px, 180px" loading="lazy" decoding="async" />
						</div>
						<div class="service-row-text">
							<h3 data-word-reveal>{service.title}</h3>
							<p data-word-reveal>{service.description}</p>
						</div>
					</div>
						<div class="service-row-end">
							<span class="service-hover-line" aria-hidden="true"></span>
							<span class="service-arrow" aria-hidden="true">↗</span>
						</div>
					</article>
				))}
			</div>
			<div class="ritual-footer" data-reveal>
				<span>Belum yakin harus memilih yang mana?</span>
				<a class="ledger-inline-link ledger-inline-link-light" href={bookingHref} target="_blank" rel="noopener noreferrer"><span>Tanya admin Mustika</span><span aria-hidden="true">↗</span></a>
			</div>
		</div>
	</section>

	<section class="ledger-experience section" id="experience" aria-labelledby="experience-title">
		<div class="shell">
			<div class="section-bar" data-reveal>
				<span>03 / Pengalaman</span>
			</div>
			<div class="experience-heading">
				<h2 id="experience-title" data-word-reveal>{experienceHeadline}<br /><em>{experienceEmphasis}</em></h2>
				<p data-word-reveal>{experienceBody}</p>
			</div>
			<ol class="journey-track" data-journey-list>
				{experienceSteps.map((step) => (
					<li data-journey-step>
						<span class="journey-step-number">{step.number}</span>
						<span class="journey-step-line" aria-hidden="true"></span>
						<h3 data-word-reveal>{step.title}</h3>
						<p data-word-reveal>{step.text}</p>
					</li>
				))}
			</ol>
		</div>
	</section>

	<section class="ledger-standards section" id="standards" aria-labelledby="standards-title">
		<div class="shell standards-layout">
			<div class="section-bar" data-reveal>
				<span>04 / Mengapa Mustika</span>
			</div>
			<div class="standards-grid">
				<div class="standards-copy">
					<h2 id="standards-title" data-word-reveal>{standardsHeadline} <em>{standardsEmphasis}</em></h2>
					<p class="standards-lede" data-word-reveal>{standardsBody}</p>
					<div class="standard-quote" data-reveal>
						<span class="quote-mark" aria-hidden="true">“</span>
						<p data-word-reveal>{standardsQuote}</p>
					</div>
				</div>
				<ul class="standard-ledger" data-standard-list>
					{standards.map((standard, index) => (
						<li data-standard-item>
							<span class="standard-index">0{index + 1}</span>
							<span>{standard}</span>
							<span class="standard-check" aria-hidden="true">↗</span>
						</li>
					))}
				</ul>
			</div>
		</div>
	</section>

	<section class="ledger-faq section" id="faq" aria-labelledby="faq-title">
		<div class="shell faq-layout">
			<div class="faq-heading">
				<div class="section-bar" data-reveal>
					<span>05 / FAQ</span>
				</div>
				<h2 id="faq-title" data-word-reveal>{faqHeadline}</h2>
				<p class="faq-lede" data-word-reveal>{faqBody}</p>
				<a class="ledger-inline-link" href={faqCtaUrl} target="_blank" rel="noopener noreferrer" data-reveal><span>{faqCtaLabel}</span><span aria-hidden="true">↗</span></a>
			</div>
			<div class="faq-ledger" data-faq-list>
				{faqs.map((faq, index) => (
					<article class="faq-row" data-faq-item data-faq-open={index === 0 ? "true" : "false"}>
						<h3 class="faq-question-heading" id={`faq-question-${index + 1}`}>
							<button
								type="button"
								class="faq-question"
								aria-expanded={index === 0 ? "true" : "false"}
								aria-controls={`faq-answer-${index + 1}`}
								data-faq-trigger
							>
								<span class="faq-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
								<span class="faq-question-label" data-word-reveal>{faq.question}</span>
								<span class="faq-toggle" aria-hidden="true"><span></span><span></span></span>
							</button>
						</h3>
						<div
							class="faq-answer"
							id={`faq-answer-${index + 1}`}
							role="region"
							aria-labelledby={`faq-question-${index + 1}`}
							data-faq-answer
						>
							<div class="faq-answer-inner"><p>{faq.answer}</p></div>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="ledger-book" id="book" aria-labelledby="book-title">
		<div class="book-visual" data-reveal data-book-visual aria-hidden="true">
			<img src="/images/mustika/mustika-space.webp" alt="" width="1200" height="801" sizes="(max-width: 760px) 70vw, 34rem" loading="lazy" decoding="async" />
			<span class="book-visual-wash"></span>
		</div>
		<div class="shell book-layout">
			<div class="book-index" data-reveal>
					<span>Booking Mustika</span>
				<span>Mustika / Bandung</span>
			</div>
			<div class="book-copy">
				<h2 id="book-title" data-word-reveal>{bookingHeadline}<br /><em>{bookingEmphasis}</em></h2>
				<p data-word-reveal>{bookingBody}</p>
				<a class="ledger-button ledger-button-light magnetic" href={bookingCtaUrl} target="_blank" rel="noopener noreferrer" data-reveal>
					<span>{bookingCtaLabel}</span>
					<span class="btn-arrow" aria-hidden="true">↗</span>
				</a>
				<span class="book-phone" data-reveal>WhatsApp · {bookingNumber}</span>
			</div>
		</div>
	</section>
</div>

<script>
	import { initMustikaLedgerMotion } from "../scripts/mustika-ledger-motion";

	initMustikaLedgerMotion();
</script>

<style>
	.mustika-ledger {
		--ledger-bone: #f0e9dd;
		--ledger-paper: #f8f4ec;
		--ledger-sage: #d6ded0;
		--ledger-ink: #1c201a;
		--ledger-ink-soft: #2d352d;
		--ledger-oxide: #a94e3b;
		--ledger-oxide-deep: #873c31;
		--ledger-gold: #c49a4e;
		--ledger-muted: #4f5a4f;
		--ledger-line: rgba(28, 32, 26, 0.18);
		--ledger-line-light: rgba(240, 233, 221, 0.26);
		background: var(--ledger-bone);
		color: var(--ledger-ink);
		overflow: clip;
	}

	.mustika-ledger .scroll-progress {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 110;
		width: 100%;
		height: 2px;
		background: var(--ledger-oxide);
		transform: scaleX(0);
		transform-origin: left center;
	}

	.mustika-ledger .section {
		position: relative;
		padding-block: clamp(5rem, 9vw, 9rem);
	}

	.mustika-ledger > section:not(.ledger-hero) {
		z-index: 1;
	}

	.ledger-hero {
		position: relative;
		height: max(620px, calc(100svh - 86px));
		min-height: 620px;
		margin-bottom: max(0px, calc(20svh + 86px));
		background: var(--ledger-bone);
		isolation: isolate;
	}

	.ledger-hero.is-pinned {
		z-index: 20;
	}

	.ledger-hero.is-released {
		visibility: hidden;
	}

	.ledger-hero-main {
		position: relative;
		height: 100%;
		z-index: 1;
	}

	.ledger-hero-top {
		display: flex;
		justify-content: flex-start;
		gap: 1rem;
		padding-top: clamp(6.8rem, 10vw, 8.8rem);
		color: var(--ledger-muted);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		line-height: 1.3;
		text-transform: uppercase;
	}

	.ledger-overline {
