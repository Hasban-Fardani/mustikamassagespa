{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "my-marketing-site",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "my-marketing-site",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "my-marketing-media",
		},
	],
	// Drives scheduled publishing, plugin cron, and maintenance (see src/worker.ts)
	"triggers": {
		"crons": ["*/5 * * * *"],
	},
	// Never add worker_loaders / PluginBridge here. Dynamic Workers need a
	// paid Cloudflare plan and will fail deploy on the free plan.
	// Workers Logs: persist invocation + console logs to the Cloudflare dashboard
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true,
		},
	},
}
